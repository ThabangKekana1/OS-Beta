{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build --webpack",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/internal/intelligence/refresh",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/internal/lifecycle/tick",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/internal/harness/reflect",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/internal/email-delivery-sync",
      "schedule": "0 5 * * *"
    }
  ],
  "functions": {
    "app/api/**/report-pack/**": {
      "memory": 2048,
      "maxDuration": 60
    }
  }
}