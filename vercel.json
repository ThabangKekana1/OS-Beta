{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build --webpack",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/internal/intelligence/refresh",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/internal/lifecycle/tick",
      "schedule": "0 7 * * *"
    }
  ]
}
